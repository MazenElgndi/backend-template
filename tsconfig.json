{
  "compilerOptions": {
    "allowJs": true,
    "checkJs": true,
    "noEmit": true,
    "module": "nodenext",
    "moduleResolution": "nodenext",
    "target": "es2022",
    "strict": false
  },
  "include": ["server.js", "src/**/*.js", "test/**/*.js", "test/**/*.mjs"],
  "exclude": ["node_modules"]
}
