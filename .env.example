# Copy this file to `.env` and fill in real values. Never commit `.env`.

NODE_ENV=development
PORT=3001

# The frontend's real deployed URL(s). Comma-separated if more than one
# (e.g. apex + www, or staging + production). Must match exactly (including
# https://, no trailing slash) or the browser will block requests with a
# CORS error.
ALLOWED_ORIGIN=https://your-domain-here.com

# Number of reverse-proxy hops between the internet and this process.
# Render/Railway/Fly.io (single reverse proxy) = 1, which is correct for
# most small deployments — but verify per host via GET /debug/ip after
# deploying (see README). Wrong value either breaks rate limiting
# (everyone shares one bucket) or makes it spoofable.
TRUST_PROXY_HOPS=1

# --- SMTP (works with any provider — Gmail, Zoho, Resend, SendGrid,
# Mailgun, Amazon SES, or the client's existing business email host) ---
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your-smtp-username
SMTP_PASS=your-smtp-password

# Where contact form submissions get delivered, and what address they're
# sent from. MAIL_FROM usually needs to be a real mailbox on SMTP_HOST's
# domain, or the provider will reject/spam-flag it.
MAIL_FROM=no-reply@your-domain-here.com
MAIL_TO=owner@your-domain-here.com

# Optional — sane defaults are used if you leave these out.
RATE_LIMIT_WINDOW_MINUTES=15
RATE_LIMIT_MAX_REQUESTS=5
